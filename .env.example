# Frontend (Next.js) — copia este archivo a `.env.local`
# Todas las variables son opcionales; si no se definen se usan los valores por defecto.

# URL base de la API FastAPI que consume el escritorio (lib/api.ts).
# En desarrollo local con el backend en el puerto 8000:
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend (FastAPI) ---
# Las variables del backend viven en `backend/.env` (ver `backend/.env.example`).
# Resumen de las más relevantes:
#
#   CORS_ORIGINS=https://danigpascual.dev,https://www.danigpascual.dev,http://localhost:3000
#   CONTACT_RATE_LIMIT=5/minute
#   CV_PDF_PATH=            # vacío => <repo>/public/cv-daniel-gonzalez-pascual.pdf
#   ENVIRONMENT=development
#   LOG_LEVEL=INFO
