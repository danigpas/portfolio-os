# Copia este archivo a `.env` y ajusta los valores.
# Todas las variables son opcionales: si no se definen, se usan los valores por defecto.

# Entorno de ejecución (development | staging | production)
ENVIRONMENT=development

# Nivel de log (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO

# Orígenes permitidos por CORS, separados por comas.
CORS_ORIGINS=https://danigpascual.dev,https://www.danigpascual.dev,http://localhost:3000

# Límite de peticiones del endpoint POST /api/contact (formato slowapi).
CONTACT_RATE_LIMIT=5/minute

# Ruta al PDF del CV. Si está vacío se usa <repo>/public/cv-daniel-gonzalez-pascual.pdf.
# Puede ser absoluta o relativa al directorio backend/.
CV_PDF_PATH=

# --- Despliegue (docker compose) ---
# Token del Cloudflare Tunnel para exponer la API (perfil "tunnel" del compose).
# Crear en Cloudflare Zero Trust -> Networks -> Tunnels y mapear
# api.danigpascual.dev -> http://api:8000
CLOUDFLARED_TOKEN=
